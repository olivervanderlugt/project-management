{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/scripts/autosave.sh\" 2>&1 || true",
            "timeout": 45,
            "statusMessage": "Autosaving the Hangar",
            "suppressOutput": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/scripts/autosave.sh\" 2>&1 || true",
            "timeout": 45,
            "statusMessage": "Autosaving the Hangar",
            "suppressOutput": true
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(python3 dashboard/build.py)",
      "Bash(python3 scripts/import_repos.py:*)"
    ]
  }
}
